# Project-maintained upstream SQLite package. Build flags follow Alpine's
# sqlite recipe; see README.md for attribution, source checksums and lifecycle.
# Reserved .invalid address is build attribution, not a support contact.
maintainer="VERIQTA local build <build@veriqta.invalid>"
pkgname=sqlite
pkgver=3.54.1
pkgrel=0
pkgdesc="Upstream SQLite security update for KubeInvestigator"
url="https://sqlite.org/"
arch="all"
license="blessing"
makedepends="build-base"
subpackages="$pkgname-libs"
source="https://sqlite.org/2026/sqlite-autoconf-3540100.tar.gz"
builddir="$srcdir/sqlite-autoconf-3540100"
options="!check" # Autoconf archive has no full upstream test suite; runtime regression runs separately.

build() {
    export CFLAGS="$CFLAGS -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_SECURE_DELETE -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_RTREE -DSQLITE_USE_URI -DSQLITE_ENABLE_DBSTAT_VTAB"
    ./configure --prefix=/usr --enable-threadsafe --disable-readline \
        --enable-session --disable-static --enable-fts3 --enable-fts4 \
        --enable-fts5 --soname=legacy
    make -j2
}

package() {
    make DESTDIR="$pkgdir" install
    # Only the -libs subpackage is installed into the final image.
    rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/pkgconfig" "$pkgdir/usr/share/man"
}

sha512sums="
3df4348f54f5cd0554eec6d91e1d08a70535b7b78f497b2c6f24910b5087f6ef70483c9e35fa388bd8f38483cb8d1cb84e98ccdd58b9f525a10e0cf48c8c6742  sqlite-autoconf-3540100.tar.gz
"
